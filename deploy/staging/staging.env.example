POSTGRES_DB=dudesign_staging
POSTGRES_USER=dudesign
POSTGRES_PASSWORD=change-me

API_PORT=4000
WEB_PORT=3001
ADMIN_PORT=3002
# Use api-system-chromium when API container must run Playwright screenshot
# pixel gate. It installs Debian Chromium once at image build time. If your
# server pulls Microsoft Container Registry quickly, api-playwright is also
# available and uses the official Playwright image with browsers preinstalled.
API_IMAGE_TARGET=api-system-chromium
APT_MIRROR=http://mirrors.tencentyun.com/debian
INSTALL_PLAYWRIGHT_DEPS=false

# Empty means same-origin API through Nginx.
# Set only the origin, for example https://api.example.com, when API is hosted separately.
# Do not include the /api path suffix here.
NEXT_PUBLIC_DUDESIGN_API_URL=
NEXT_PUBLIC_DUDESIGN_ADMIN_BASE_PATH=/admin

# Optional OAuth sign-in providers. Leave empty to hide/disable the provider on
# the login page. For hosted staging/production, use HTTPS callback URLs:
#   https://your-domain/api/auth/oauth/github/callback
#   https://your-domain/api/auth/oauth/google/callback
DUDESIGN_OAUTH_GITHUB_CLIENT_ID=
DUDESIGN_OAUTH_GITHUB_CLIENT_SECRET=
DUDESIGN_OAUTH_GITHUB_REDIRECT_URI=
DUDESIGN_OAUTH_GOOGLE_CLIENT_ID=
DUDESIGN_OAUTH_GOOGLE_CLIENT_SECRET=
DUDESIGN_OAUTH_GOOGLE_REDIRECT_URI=

# Runtime provider:
# - mock: built-in DUDesign mock runtime.
# - babel-o: external BabeL-O-compatible runtime adapter service.
DUDESIGN_RUNTIME_PROVIDER=mock

# Required when DUDESIGN_RUNTIME_PROVIDER=babel-o.
# Point this to the DUDesign/BabeL-O runtime adapter base URL, not the raw Nexus
# server unless Nexus exposes the DUDesign runtime contract endpoints.
BABELO_BASE_URL=
BABELO_API_KEY=
BABELO_AUTH_HEADER=
BABELO_TIMEOUT_MS=120000
BABELO_STREAM_IDLE_TIMEOUT_MS=
BABELO_STREAM_RECONNECT_ATTEMPTS=
BABELO_CONTRACT_VERSION=
# Limits simultaneous variation streams sent from DUDesign API to the runtime adapter.
# Staging and production default to 3 so a user-selected 6-variation job is
# executed in two batches instead of overloading BabeL-O/raw model capacity.
DUDESIGN_RUNTIME_VARIATION_CONCURRENCY=3

# MCP executor provider:
# - mock: built-in safe mock executor for local/staging validation.
# - http: calls a DUDesign-compatible MCP executor endpoint with the standard
#   { request } envelope and expects a standard MCP result envelope back.
DUDESIGN_MCP_EXECUTOR=mock
DUDESIGN_MCP_BASE_URL=
DUDESIGN_MCP_ENDPOINT_PATH=/v1/mcp/invocations
DUDESIGN_MCP_API_KEY=
DUDESIGN_MCP_AUTH_HEADER=
DUDESIGN_MCP_TIMEOUT_MS=30000
# Optional server-side image generation provider. Leave empty to keep the safe
# mock image MCP path. Set to ark_seedream only on hosts where ARK_API_KEY is
# available as a server secret.
DUDESIGN_IMAGE_GENERATION_PROVIDER=
ARK_API_KEY=
ARK_IMAGE_GENERATION_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
ARK_IMAGE_TIMEOUT_MS=90000
# Optional real Ark image provider smoke. Default is skipped so staging deploys
# do not depend on external paid services. Set to 1 only with a valid ARK key.
DUDESIGN_STAGING_ARK_REAL_SMOKE=0
DUDESIGN_STAGING_ARK_API_KEY=
DUDESIGN_STAGING_ARK_IMAGE_GENERATION_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
DUDESIGN_STAGING_ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
DUDESIGN_STAGING_ARK_IMAGE_TIMEOUT_MS=90000
DUDESIGN_STAGING_ARK_IMAGE_PROMPT=Original blue abstract knowledge-card illustration, geometric layers, clean editorial visual, no logo, no copyrighted character.
DUDESIGN_STAGING_ARK_IMAGE_SIZE=2K
# Staging smoke keeps a local mock MCP server by default. Set these only when
# intentionally validating a real DUDesign-compatible MCP server.
DUDESIGN_STAGING_MCP_REAL_SMOKE=0
DUDESIGN_STAGING_MCP_REAL_BASE_URL=
DUDESIGN_STAGING_MCP_REAL_ENDPOINT_PATH=/v1/mcp/invocations
DUDESIGN_STAGING_MCP_REAL_API_KEY=
DUDESIGN_STAGING_MCP_REAL_AUTH_HEADER=
DUDESIGN_STAGING_MCP_REAL_TIMEOUT_MS=30000
# Optional Agent-Reach staging smoke. Requires mcporter on the staging host, or
# AGENT_REACH_SEARCH_COMMAND to be exported before running the smoke script.
DUDESIGN_STAGING_AGENT_REACH_MCP_PORT=4520
DUDESIGN_STAGING_AGENT_REACH_QUERY=dynamic encyclopedia card iframe interaction references
# Optional local-to-remote command bridge. The command runs on the staging host
# and receives {"query": "...", "numResults": N} on stdin.
DUDESIGN_STAGING_AGENT_REACH_SEARCH_COMMAND=
# Optional explicit mcporter config path on the staging host. If empty, smoke
# tries $HOME/config/mcporter.json and $HOME/.mcporter/mcporter.json.
DUDESIGN_STAGING_AGENT_REACH_MCPORTER_CONFIG=

# Optional dynamic encyclopedia vertical matrix smoke. Default is disabled so a
# normal staging smoke only runs one low-cost dynamic encyclopedia generation.
# Set to 1 to run film / TV / historical person / cultural phrase cases against
# real BabeL-O and assert their vertical spec findings stay clean.
DUDESIGN_STAGING_DYNAMIC_ENCYCLOPEDIA_VERTICAL_MATRIX=0
DUDESIGN_STAGING_DYNAMIC_ENCYCLOPEDIA_TIMEOUT_SECONDS=720
DUDESIGN_STAGING_DYNAMIC_ENCYCLOPEDIA_VARIATION_COUNT=1
# Set to 1 with VARIATION_COUNT>=3 after enabling babel-o-multilane profile.
# The smoke then reports completed variation lane distribution. By default lane
# concentration is a warning because retry may rescue all work onto one healthy
# lane while generation still succeeds.
DUDESIGN_STAGING_DYNAMIC_ENCYCLOPEDIA_MULTILANE_SMOKE=0
# Set to 1 only when verifying final completed artifacts must come from at least
# two runtime lanes. Keep 0 for normal release smoke.
DUDESIGN_STAGING_DYNAMIC_ENCYCLOPEDIA_COMPLETION_LANE_REQUIRED=0
# Optional real browser check for generated card interactions. Requires the API
# image target to include Playwright browsers or system Chromium. The default
# api-system-chromium target supports this via PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH.
DUDESIGN_STAGING_DYNAMIC_ENCYCLOPEDIA_INTERACTION_SMOKE=0
# Set to 1 when the selected template/context must produce tab interaction.
# When 0, the smoke skips pages without tab controls but still verifies any
# generated tab controls are real.
DUDESIGN_STAGING_DYNAMIC_ENCYCLOPEDIA_INTERACTION_REQUIRED=0

# Runtime adapter service. Enable with:
# docker compose --profile babel-o -f deploy/staging/docker-compose.yml --env-file deploy/staging/.env up -d --build
RUNTIME_ADAPTER_PORT=4100
RUNTIME_ADAPTER_STATE_FILE=/app/.dudesign/runtime-adapter/state.json
# Retry transient raw BabeL-O /v1/execute capacity limits. This complements
# the API-side variation concurrency gate; it is not a substitute for it.
RUNTIME_ADAPTER_EXECUTE_RETRY_ATTEMPTS=6
RUNTIME_ADAPTER_EXECUTE_RETRY_BASE_DELAY_MS=1500
# Number of lane switches after the first attempt. With three static lanes this
# should be 2 so a soft runtime failure can try every lane once.
RUNTIME_ADAPTER_LANE_RETRY_ATTEMPTS=2
# When a retry needs another lane but all alternate lanes are briefly busy, wait
# inside this window instead of failing the variation immediately.
RUNTIME_ADAPTER_LANE_ACQUIRE_TIMEOUT_MS=300000
RUNTIME_ADAPTER_LANE_ACQUIRE_POLL_MS=250
# Raw Nexus may cap execute timeout lower than the full stream watchdog. Keep
# execute at 300s unless the deployed Babel-O contract explicitly supports more,
# while allowing the adapter to keep consuming long-running streams.
RUNTIME_ADAPTER_EXECUTE_TIMEOUT_MS=300000
RUNTIME_ADAPTER_WATCHDOG_TIMEOUT_MS=600000

# Raw BabeL-O Nexus endpoint consumed by the DUDesign runtime adapter.
# Do not point DUDesign API directly at raw Nexus.
BABELO_NEXUS_BASE_URL=http://babel-o-nexus:3000
# Replace before production. Staging default is only for internal compose networking.
BABELO_NEXUS_API_KEY=dudesign-staging-babelo-key
BABELO_NEXUS_AUTH_HEADER=
# Runtime Lane Pool static config. Leave JSON empty for single-lane behavior.
# To start three staging lanes, use:
# docker compose --profile babel-o-multilane -f deploy/staging/docker-compose.yml --env-file deploy/staging/.env up -d --build
DUDESIGN_RUNTIME_LANE_MODE=single
DUDESIGN_RUNTIME_LANES_JSON=
# Example multi-lane value:
# DUDESIGN_RUNTIME_LANE_MODE=static
# DUDESIGN_RUNTIME_LANES_JSON=[{"id":"lane-a","backendId":"nexus-a","provider":"babel-o","baseUrl":"http://babel-o-nexus:3000","workspaceRoot":"/workspace","maxConcurrent":1,"weight":1,"contractVersion":"2026-06-26.dudesign-runtime.v1"},{"id":"lane-b","backendId":"nexus-b","provider":"babel-o","baseUrl":"http://babel-o-nexus-b:3000","workspaceRoot":"/runtime-workspaces/lane-b","maxConcurrent":1,"weight":1,"contractVersion":"2026-06-26.dudesign-runtime.v1"},{"id":"lane-c","backendId":"nexus-c","provider":"babel-o","baseUrl":"http://babel-o-nexus-c:3000","workspaceRoot":"/runtime-workspaces/lane-c","maxConcurrent":1,"weight":1,"contractVersion":"2026-06-26.dudesign-runtime.v1"}]

# Raw BabeL-O Nexus service. Keep BabeL-O source outside DUDesign and point
# BABELO_NEXUS_CONTEXT to that checked-out/released source directory on server.
BABELO_NEXUS_CONTEXT=/home/ubuntu/deployments/babel-o/current
BABELO_NEXUS_DOCKERFILE=/tmp/dudesign-babelo-nexus.Dockerfile
BABELO_NEXUS_PORT=3300
BABELO_NEXUS_B_PORT=3312
BABELO_NEXUS_C_PORT=3313
BABELO_NEXUS_ALLOWED_TOOLS=Read,ListDir,Glob,Grep,Write,Edit
BABELO_NEXUS_EXECUTE_TIMEOUT_MS=600000
BABELO_NEXUS_MAX_CONCURRENT_EXECUTIONS=4
BABELO_NEXUS_LANE_MAX_CONCURRENT_EXECUTIONS=1
BABELO_NEXUS_CONFIG_FILE=
